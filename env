#!/bin/bash

if (( $# != 1 )); then
    echo "Usage: $0 [env_type]"
    echo "  where env_type is: lms, lms_dev, cms, or cms_dev"
else
    export DJANGO_SETTINGS_MODULE="openedx_site.settings_$1"
    export LMS_CFG=../openedx-platform/lms/envs/minimal.yml
    export CMS_CFG="$LMS_CFG"

    echo "Environment:"
    echo "  DJANGO_SETTINGS_MODULE=$DJANGO_SETTINGS_MODULE"
    echo "  LMS_CFG=$LMS_CFG"
    echo "  CMS_CFG=$CMS_CFG"
    echo "Please sanity-check these before proceeding."
fi

