# Source this into your shell to set up your dev environment:
#
#     . env
#
# It exports the variables from `env_vars` (so subprocesses like ./manage.py
# see them) and activates the Python virtualenv.

# Export every assignment in env_vars without needing `export` on each line.
# `set -a` (allexport) keeps env_vars as plain KEY=VALUE for docker compose.
set -a
. ./env_vars
set +a

# Activate the virtualenv for convenience.
. .venv/bin/activate
