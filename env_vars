# Environment variables for this repo.
# NOT SAFE FOR PRODUCTION. THIS IS JUST A DEV ENV FOR NOW. @@TODO
#
# Plain KEY=VALUE lines and comments only, so this file works both as a docker
# compose `env_file` and as something `env` can source. Don't add `export` or
# shell logic here -- put that in `env`.

# MySQL. Three consumers read these names:
#  1. the official mysql image's entrypoint, which creates MYSQL_DATABASE and
#     MYSQL_USER/MYSQL_PASSWORD -- but only while the datadir is empty, so once
#     per volume, not per container (compose.yml passes this file as env_file);
#  2. provision.sh, which reconciles the same objects on every run, covering
#     changes made here after the volume was already initialised;
#  3. our Django settings overrides (shared_settings_overrides_dev.py), which
#     build DATABASES from them.
# MYSQL_ROOT_* is ours alone (provision.sh, sqlshell.sh); the image's own name
# for the password is MYSQL_ROOT_PASSWORD, which is why it's spelled that way.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=openedx
MYSQL_USER=openedx
MYSQL_PASSWORD=password
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=password

# MongoDB. Same three consumers as MySQL above: the mongo image's entrypoint
# creates the root user from MONGO_INITDB_* (once per volume), provision.sh and
# mongoshell.sh authenticate with them, and the settings overrides build
# DOC_STORE_CONFIG/CONTENTSTORE from them.
# Don't rename these to something friendlier: compose can only interpolate
# `${...}` from the host environment, never from an env_file, so relaying them
# under different names via `environment:` silently yields empty strings and
# mongo comes up with no auth at all.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_INITDB_DATABASE=openedx
MONGO_INITDB_ROOT_USERNAME=openedx
MONGO_INITDB_ROOT_PASSWORD=password

# Config yamls, relative to openedx-platform or openedx-template-site root.
LMS_CFG=../openedx-platform/lms/envs/minimal.yml
CMS_CFG="$LMS_CFG"

# CMS (Studio) SSO OAuth2 client. Studio authenticates against the LMS via
# social-auth (edx-oauth2). These must match between the DOT application
# created in the LMS (see provision.sh) and the CMS settings that present them.
CMS_SSO_OAUTH2_KEY=cms-sso-dev
CMS_SSO_OAUTH2_SECRET=cms-sso-dev-secret

# Meilisearch (Studio/course search). MEILI_* are read by the meilisearch
# container (see compose.yml); the settings derive the backend API key's value
# from MEILI_MASTER_KEY + the fixed key UID (Meilisearch derives key values
# deterministically from those), and provision.sh creates that key.
MEILI_MASTER_KEY=openedx-insecure-meilisearch-master-key
MEILI_NO_ANALYTICS=true
MEILISEARCH_API_KEY_UID=a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d
MEILISEARCH_INDEX_PREFIX=openedx_

# Default django settings to LMS dev.
# Override it to DJANGO_SETTINGS_MODULE=openedx_site.settings_cms_dev for CMS
# @@TODO in the future, default to this to prod, not dev.
DJANGO_SETTINGS_MODULE=openedx_site.settings_lms_dev

# Static asset collection dir.
# @@TODO I think things break if this is put anywhere else.
#        Need to figure out how to make it safely configurable.
#        Would like to move it within openedx-template-site by default.
STATIC_ROOT_LMS="$(pwd)/staticfiles" #"$HOME/openedx/staticfiles"  # @@TODO
STATIC_ROOT_CMS="$STATIC_ROOT_LMS/studio"

# Tell Turbo (our frontend build tool) not to do telemetry on us
DO_NOT_TRACK=1
