# Environment variables for this repo.
# NOT SAFE FOR PRODUCTION. THIS IS JUST A DEV ENV FOR NOW. @@TODO
#
# Plain KEY=VALUE lines and comments only: docker compose reads this as an
# `env_file`, and `env` sources it as a shell script. An `export` or any shell
# logic would break the compose side, so put those in `env`.

# MySQL. Three consumers:
#  1. compose.yml passes these to the official mysql image's entrypoint, which
#     initializes the db and user when the data volume is empty.
#  2. provision.sh re-applies them on every run.
#  3. our dev settings overrides build DATABASES from them.
# MYSQL_ROOT_* is just for our own scripts (provision.sh, sqlshell.sh).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=openedx
MYSQL_USER=openedx
MYSQL_PASSWORD=password
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=password

# MongoDB. Same three consumers as MySQL.
# Note: the official mongo entrypoint only recognizes these MONGO_INITDB_* names.
# Renaming them would start mongo with no auth at all -- quietly, and dangerously.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_INITDB_DATABASE=openedx
MONGO_INITDB_ROOT_USERNAME=openedx
MONGO_INITDB_ROOT_PASSWORD=password

# Config yamls, relative to openedx-platform or openedx-template-site root.
LMS_CFG=../openedx-platform/lms/envs/minimal.yml
CMS_CFG="$LMS_CFG"

# CMS (Studio) SSO OAuth2 client. Studio authenticates users against the LMS via
# social-auth (edx-oauth2), so these must match the DOT application that
# provision.sh creates in the LMS. A mismatch would break Studio login.
CMS_SSO_OAUTH2_KEY=cms-sso-dev
CMS_SSO_OAUTH2_SECRET=cms-sso-dev-secret

# Meilisearch (Studio/course search). The container reads MEILI_* (see
# compose.yml). Meilisearch derives a key's value from the master key + key UID,
# so our settings compute MEILISEARCH_API_KEY instead of storing it.
MEILI_MASTER_KEY=openedx-insecure-meilisearch-master-key
MEILI_NO_ANALYTICS=true
MEILISEARCH_API_KEY_UID=a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d
MEILISEARCH_INDEX_PREFIX=openedx_

# Django settings module. Defaults to LMS dev; `env_cms` switches it to
# openedx_site.settings_cms_dev for CMS/Studio commands.
# @@TODO default to prod, not dev.
DJANGO_SETTINGS_MODULE=openedx_site.settings_lms_dev

# Static asset collection dir.
# @@TODO I think things break if this is put anywhere else.
#        Need to figure out how to make it safely configurable.
#        Would like to move it within openedx-template-site by default.
STATIC_ROOT_LMS="$(pwd)/staticfiles" #"$HOME/openedx/staticfiles"  # @@TODO
STATIC_ROOT_CMS="$STATIC_ROOT_LMS/studio"

# Tell Turbo (our frontend build tool) not to do telemetry on us
DO_NOT_TRACK=1
